#!/usr/bin/env python3
"""Print the current branch's Claude Code token usage as a PR-description snippet.

Usage:
  pr-tokens            # the branch checked out here
  pr-tokens --pr 36    # also count sessions linked to PR 36 from any directory
  pr-tokens --branch feat/x --repo /path/to/repo

Reads the session transcripts through bin/transcripts.py; see that file for what counts.
Paste the output at the bottom of the PR description.
"""

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "bin"))
import transcripts  # noqa: E402

if __name__ == "__main__":
    args = sys.argv[1:]
    if args[:1] in (["-h"], ["--help"]):
        print(__doc__.strip())
        sys.exit(0)
    sys.exit(transcripts.main(["tokens", *args]))
